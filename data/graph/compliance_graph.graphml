<graph edgedefault="directed"><node id="req:d59ed6cc90812948">
  <data key="d0">requirement</data>
  <data key="d1">insurance and reinsurance companies are required to implement management systems that will assure correct and prudent management of the business in consideration of its nature, scale and complexity.</data>
  <data key="d2">Insurance and reinsurance companies must implement management systems for prudent business management.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">high</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="domain:internal_audit">
  <data key="d0">domain</data>
  <data key="d6">internal_audit</data>
</node>
<node id="reg_file:Audit COntol for Insurance Companies.pdf">
  <data key="d0">regulatory_file</data>
  <data key="d6">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:c14a582185522129">
  <data key="d0">requirement</data>
  <data key="d1">Insurance and reinsurance companies are required to maintain written rules of risk management, internal controls, internal audits and outsourcing, to be reviewed annually, mainly in the framework of n</data>
  <data key="d2">Insurance and reinsurance companies must maintain and annually review written rules of risk management, internal controls, internal audits, and outsourcing.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">medium</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:8287989818165e19">
  <data key="d0">requirement</data>
  <data key="d1">they should be subject to regular internal reviews every year as a minimum</data>
  <data key="d2">Conduct regular internal reviews of the control mechanisms at least annually.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">medium</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:140c8c904665220f">
  <data key="d0">requirement</data>
  <data key="d1">they should be approved by an administrative, management or supervisory authority</data>
  <data key="d2">Obtain approval of the control mechanisms from the relevant authority.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">medium</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:c63701fb77e9ffa8">
  <data key="d0">requirement</data>
  <data key="d1">a control system should be verified by a supervisory authority with regard to risks identified by the insurer that may affect adequate financial standing</data>
  <data key="d2">A control system must be verified by a supervisory authority regarding identified risks.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">high</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:8dcd9e5db1f7803e">
  <data key="d0">requirement</data>
  <data key="d1">a supervisory authority should have the right to require improvement and strengthening of the management system</data>
  <data key="d2">A supervisory authority must have the right to mandate improvements to the management system.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">medium</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:31558987c10cfdc6">
  <data key="d0">requirement</data>
  <data key="d1">rules of risk management, internal audit, internal control and outsourcing should be executed in writing</data>
  <data key="d2">Rules of risk management, internal audit, internal control, and outsourcing must be documented in writing.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">medium</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:11ef0486a4a50a3b">
  <data key="d0">requirement</data>
  <data key="d1">companies were required to establish audit committees by 6 December, 2009, i.e. within six months of the effective date of the amended Expert Auditors Act.</data>
  <data key="d2">Companies must establish audit committees by the specified deadline.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">high</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:0f313b48ee24e598">
  <data key="d0">requirement</data>
  <data key="d1">companies were required to establish by 6 December, 2009, i.e. within six months of the effective date of the amended Expert Auditors Act.</data>
  <data key="d2">Companies must establish an audit committee by December 6, 2009.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">high</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:2d74a8853bb49ec7">
  <data key="d0">requirement</data>
  <data key="d1">Audit committees must have a minimum of three members, including at least one independent member with accounting or financial auditing qualifications.</data>
  <data key="d2">Audit committees must consist of at least three members, including one independent member with relevant qualifications.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">high</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:404df656a590cac1">
  <data key="d0">requirement</data>
  <data key="d1">audit commissions consisting of a minimum of 3 members, including at least 1 member meeting the conditions of independence with accounting or financial auditing qualifications</data>
  <data key="d2">Audit commissions must consist of a minimum of 3 members, including at least 1 independent member with accounting or financial auditing qualifications.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">high</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:3b8357525b4a759c">
  <data key="d0">requirement</data>
  <data key="d1">supervisory boards comprising not more than 5 members</data>
  <data key="d2">Supervisory boards must comprise no more than 5 members.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">high</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
<node id="req:b631e5e79b3c3543">
  <data key="d0">requirement</data>
  <data key="d1">businesses are obliged to set them up and supply them with relevant instruments and mechanisms of control.</data>
  <data key="d2">Businesses must establish audit committees and provide them with necessary tools and controls.</data>
  <data key="d3">internal_audit</data>
  <data key="d4">high</data>
  <data key="d5">Audit COntol for Insurance Companies.pdf</data>
</node>
